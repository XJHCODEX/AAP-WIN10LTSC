<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ report.title }} — {{ report.hostname }}</title>
  <style>
    :root {
      --bg: #0f1419;
      --surface: #1a2332;
      --surface2: #243044;
      --border: #2d3a4f;
      --text: #e8eef7;
      --muted: #8b9cb3;
      --pass: #3dd68c;
      --fail: #ff6b6b;
      --warn: #ffc857;
      --info: #6eb5ff;
      --accent: #ee0000;
      --accent2: #ff4d4d;
      --radius: 12px;
      --font: "Segoe UI", system-ui, -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }
    .page { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; }
    .brand-icon {
      width: 48px; height: 48px;
      background: linear-gradient(135deg, var(--accent), #b80000);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 1.1rem; color: #fff;
    }
    h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
    .subtitle { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
    .meta { text-align: right; font-size: 0.85rem; color: var(--muted); }
    .meta strong { color: var(--text); display: block; font-size: 1rem; }
    .score-panel {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
      align-items: center;
    }
    @media (max-width: 700px) { .score-panel { grid-template-columns: 1fr; } }
    .ring-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      text-align: center;
    }
    .ring {
      width: 140px; height: 140px;
      margin: 0 auto 0.75rem;
      border-radius: 50%;
      background: conic-gradient(
        var(--pass) 0deg {{ (report.summary.score_percent | float) * 3.6 }}deg,
        var(--surface2) {{ (report.summary.score_percent | float) * 3.6 }}deg 360deg
      );
      display: flex; align-items: center; justify-content: center;
      position: relative;
    }
    .ring::before {
      content: "";
      position: absolute;
      inset: 12px;
      background: var(--surface);
      border-radius: 50%;
    }
    .ring span {
      position: relative;
      font-size: 2rem;
      font-weight: 800;
      color: var(--text);
    }
    .ring-label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    @media (max-width: 600px) { .cards { grid-template-columns: repeat(2, 1fr); } }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem;
      text-align: center;
    }
    .card .num { font-size: 1.75rem; font-weight: 800; }
    .card .lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; margin-top: 0.2rem; }
    .card.pass .num { color: var(--pass); }
    .card.fail .num { color: var(--fail); }
    .card.warn .num { color: var(--warn); }
    .card.info .num { color: var(--info); }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
      align-items: center;
    }
    .toolbar label { color: var(--muted); font-size: 0.85rem; margin-right: 0.5rem; }
    .filter-btn {
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--accent);
      border-color: var(--accent2);
      color: #fff;
    }
    .table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background: var(--surface2); }
    th {
      text-align: left;
      padding: 0.75rem 1rem;
      font-weight: 600;
      color: var(--muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    td { padding: 0.85rem 1rem; border-top: 1px solid var(--border); vertical-align: top; }
    tr:hover td { background: rgba(255,255,255,0.02); }
    .badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .badge-PASS { background: rgba(61,214,140,0.2); color: var(--pass); }
    .badge-FAIL { background: rgba(255,107,107,0.2); color: var(--fail); }
    .badge-WARN { background: rgba(255,200,87,0.2); color: var(--warn); }
    .badge-INFO { background: rgba(110,181,255,0.2); color: var(--info); }
    .control-id { font-family: ui-monospace, monospace; font-size: 0.8rem; color: var(--muted); }
    .evidence { color: var(--muted); font-size: 0.82rem; margin-top: 0.2rem; }
    .remediation {
      font-size: 0.8rem;
      color: var(--warn);
      margin-top: 0.35rem;
      padding-left: 0.5rem;
      border-left: 2px solid var(--warn);
    }
    footer {
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--muted);
      text-align: center;
    }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div class="brand">
        <div class="brand-icon">AAP</div>
        <div>
          <h1>{{ report.title }}</h1>
          <p class="subtitle">Profile {{ report.profile }} v{{ report.version }} &middot; Ansible Automation Platform</p>
        </div>
      </div>
      <div class="meta">
        <strong>{{ report.hostname }}</strong>
        Generated {{ report.generated_utc }} UTC<br />
        Target: {{ report.hostname }}
      </div>
    </header>

    <section class="score-panel">
      <div class="ring-wrap">
        <div class="ring" aria-label="Compliance score"><span>{{ report.summary.score_percent }}%</span></div>
        <div class="ring-label">Compliance score</div>
      </div>
      <div class="cards">
        <div class="card pass"><div class="num">{{ report.summary.pass }}</div><div class="lbl">Pass</div></div>
        <div class="card fail"><div class="num">{{ report.summary.fail }}</div><div class="lbl">Fail</div></div>
        <div class="card warn"><div class="num">{{ report.summary.warn }}</div><div class="lbl">Warn</div></div>
        <div class="card info"><div class="num">{{ report.summary.info }}</div><div class="lbl">Info</div></div>
      </div>
    </section>

    <div class="toolbar">
      <label>Filter:</label>
      <button type="button" class="filter-btn active" data-filter="ALL">All ({{ report.summary.total }})</button>
      <button type="button" class="filter-btn" data-filter="PASS">Pass</button>
      <button type="button" class="filter-btn" data-filter="FAIL">Fail</button>
      <button type="button" class="filter-btn" data-filter="WARN">Warn</button>
      <button type="button" class="filter-btn" data-filter="INFO">Info</button>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Result</th>
            <th>Control</th>
            <th>Category</th>
            <th>Title &amp; evidence</th>
          </tr>
        </thead>
        <tbody>
{% for c in report.checks %}
          <tr class="row" data-result="{{ c.result }}">
            <td><span class="badge badge-{{ c.result }}">{{ c.result }}</span></td>
            <td><span class="control-id">{{ c.id }}</span></td>
            <td>{{ c.category }}</td>
            <td>
              <strong>{{ c.title }}</strong>
              <div class="evidence">{{ c.evidence }}</div>
{% if c.remediation %}
              <div class="remediation">Remediation: {{ c.remediation }}</div>
{% endif %}
            </td>
          </tr>
{% endfor %}
        </tbody>
      </table>
    </div>

    <footer>
      Read-only compliance assessment for demonstration. Not a certified CIS, STIG, or regulatory attestation.
      Produced by Ansible role <code>windows_compliance_report</code>.
    </footer>
  </div>
  <script>
    document.querySelectorAll('.filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var f = btn.getAttribute('data-filter');
        document.querySelectorAll('tbody .row').forEach(function(row) {
          row.classList.toggle('hidden', f !== 'ALL' && row.getAttribute('data-result') !== f);
        });
      });
    });
  </script>
</body>
</html>
